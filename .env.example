# E-Mail-Adresse des Google Service Accounts (aus der JSON-Schlüsseldatei: "client_email")
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@dein-projekt.iam.gserviceaccount.com

# Private Key des Service Accounts (aus der JSON-Schlüsseldatei: "private_key")
# Zeilenumbrüche als \n einfügen und den gesamten Wert in Anführungszeichen setzen.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# ID des Google-Drive-Ordners, in den hochgeladen werden soll
# (zu finden in der URL des Ordners: https://drive.google.com/drive/folders/<ORDNER_ID>)
GOOGLE_DRIVE_FOLDER_ID=deine-google-drive-ordner-id
